        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">CharacterAppearance</string>
            <string name="Source"><![CDATA[-- Shared visual-only uniforms. Currency and unlocks remain in ProfileService.
local GameConfig = require(script.Parent:WaitForChild("GameConfig"))
local Appearance = {}
function Appearance.Apply(character, skinKey)
    local skin = GameConfig.Skins[skinKey]
    if not skin or not character then return end
    -- A purchased role is a complete uniform set. Clear layered clothes and
    -- headwear that would cover it, while retaining the player's face and skin.
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Accessory") or item:IsA("ShirtGraphic") then
            item:Destroy()
        elseif item:IsA("Shirt") and (not skin.ShirtTemplate or skin.ShirtTemplate <= 0) then
            item:Destroy()
        elseif item:IsA("Pants") and (not skin.PantsTemplate or skin.PantsTemplate <= 0) then
            item:Destroy()
        end
    end

    local bodyColors = character:FindFirstChildOfClass("BodyColors")
    if not bodyColors then
        bodyColors = Instance.new("BodyColors")
        bodyColors.Parent = character
    end
    local main = skin.Colors.Main
    local accent = skin.Colors.Accent
    local darkTrim = main:Lerp(Color3.fromRGB(8, 15, 20), 0.36)
    -- Keep the player's actual skin tone. Earlier skins painted the head in the
    -- uniform accent color, which made every preview look like a plastic mask.
    local originalHeadColor = character:GetAttribute("LastTrainOriginalHeadColor")
    if typeof(originalHeadColor) ~= "Color3" then
        originalHeadColor = bodyColors.HeadColor3
        character:SetAttribute("LastTrainOriginalHeadColor", originalHeadColor)
    end
    bodyColors.HeadColor3 = originalHeadColor
    bodyColors.LeftArmColor3 = main
    bodyColors.RightArmColor3 = main
    bodyColors.LeftLegColor3 = main
    bodyColors.RightLegColor3 = main
    bodyColors.TorsoColor3 = main

    local oldVisuals = character:FindFirstChild("LastTrainSkinVisuals")
    if oldVisuals then oldVisuals:Destroy() end
    local visuals = Instance.new("Folder")
    visuals.Name = "LastTrainSkinVisuals"
    visuals.Parent = character
    local head = character:FindFirstChild("Head")
    local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")

    local function weldedPart(name, parentPart, size, color, offset, material, shape)
        if not parentPart then return end
        local visual = Instance.new("Part")
        visual.Name = name
        visual.Size = size
        visual.Color = color
        visual.Material = material or Enum.Material.SmoothPlastic
        visual.Shape = shape or Enum.PartType.Block
        visual.Anchored = false
        visual.Massless = true
        visual.CanCollide = false
        visual.CanTouch = false
        visual.CanQuery = false
        visual.CastShadow = true
        visual.CFrame = parentPart.CFrame * offset
        visual.Parent = visuals
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = parentPart
        weld.Part1 = visual
        weld.Parent = visual
        return visual
    end

    if torso then
        local width, height, depth = torso.Size.X, torso.Size.Y, torso.Size.Z
        local front = -(depth / 2 + 0.045)
        local softMain = main:Lerp(Color3.fromRGB(255, 255, 255), 0.08)

        -- Tailored front panels, collar, pockets, buttons and a readable badge
        -- make each loadout feel like a designed uniform on R6 and R15 bodies.
        weldedPart("UniformJacketFront", torso, Vector3.new(width * 0.76, height * 0.78, 0.08), softMain, CFrame.new(0, 0, front), Enum.Material.Fabric)
        weldedPart("UniformCollarLeft", torso, Vector3.new(width * 0.23, 0.12, 0.1), accent, CFrame.new(-width * 0.18, height * 0.34, front - 0.025), Enum.Material.SmoothPlastic)
        weldedPart("UniformCollarRight", torso, Vector3.new(width * 0.23, 0.12, 0.1), accent, CFrame.new(width * 0.18, height * 0.34, front - 0.025), Enum.Material.SmoothPlastic)
        weldedPart("UniformPlacket", torso, Vector3.new(0.1, height * 0.55, 0.07), accent, CFrame.new(0, 0, front - 0.06), Enum.Material.Metal)
        weldedPart("UniformPocketLeft", torso, Vector3.new(width * 0.2, height * 0.18, 0.07), darkTrim, CFrame.new(-width * 0.23, height * 0.1, front - 0.04), Enum.Material.Fabric)
        weldedPart("UniformPocketRight", torso, Vector3.new(width * 0.2, height * 0.18, 0.07), darkTrim, CFrame.new(width * 0.23, height * 0.1, front - 0.04), Enum.Material.Fabric)
        weldedPart("UniformNameBadge", torso, Vector3.new(0.2, 0.24, 0.09), accent, CFrame.new(-width * 0.24, height * 0.28, front - 0.08), Enum.Material.Metal, Enum.PartType.Ball)
        weldedPart("UniformBelt", torso, Vector3.new(width * 0.7, 0.1, 0.07), darkTrim, CFrame.new(0, -height * 0.38, front - 0.035), Enum.Material.Metal)
        weldedPart("UniformBuckle", torso, Vector3.new(0.2, 0.16, 0.09), accent, CFrame.new(0, -height * 0.38, front - 0.08), Enum.Material.Metal)
        local back = depth / 2 + 0.04
        weldedPart("UniformBackYoke", torso, Vector3.new(width * 0.72, height * 0.2, 0.07), darkTrim, CFrame.new(0, height * 0.29, back), Enum.Material.Fabric)
        weldedPart("UniformBackSeam", torso, Vector3.new(0.045, height * 0.48, 0.08), accent, CFrame.new(0, -height * 0.04, back + 0.015), Enum.Material.Metal)
        weldedPart("UniformBackReflector", torso, Vector3.new(width * 0.67, 0.09, 0.08), accent, CFrame.new(0, -height * 0.3, back), Enum.Material.SmoothPlastic)
    end

    for _, side in ipairs({"Left", "Right"}) do
        local upperArm = character:FindFirstChild(side .. "UpperArm") or character:FindFirstChild(side .. " Arm")
        local lowerArm = character:FindFirstChild(side .. "LowerArm")
        local arm = lowerArm or upperArm
        if arm then
            local front = -(arm.Size.Z / 2 + 0.035)
            weldedPart("UniformSleeveStripe_" .. side, arm, Vector3.new(arm.Size.X * 0.86, 0.075, 0.06), accent, CFrame.new(0, -arm.Size.Y * 0.28, front), Enum.Material.SmoothPlastic)
        end
        if upperArm then
            local front = -(upperArm.Size.Z / 2 + 0.035)
            weldedPart("UniformShoulderTab_" .. side, upperArm, Vector3.new(upperArm.Size.X * 0.72, 0.12, 0.08), darkTrim, CFrame.new(0, upperArm.Size.Y * 0.35, front), Enum.Material.Metal)
        end
    end

    local lowerTorso = character:FindFirstChild("LowerTorso")
    if lowerTorso then
        local front = -(lowerTorso.Size.Z / 2 + 0.04)
        weldedPart("UniformUtilityBelt", lowerTorso, Vector3.new(lowerTorso.Size.X * 0.78, 0.12, 0.08), darkTrim, CFrame.new(0, -lowerTorso.Size.Y * 0.3, front), Enum.Material.Metal)
    end

    for _, footName in ipairs({"LeftFoot", "RightFoot"}) do
        local foot = character:FindFirstChild(footName)
        if foot then
            weldedPart("UniformBoot_" .. footName, foot, Vector3.new(foot.Size.X * 1.08, foot.Size.Y * 0.62, foot.Size.Z * 1.08), darkTrim, CFrame.new(0, -foot.Size.Y * 0.16, 0), Enum.Material.Leather, Enum.PartType.Ball)
            weldedPart("UniformBootTrim_" .. footName, foot, Vector3.new(foot.Size.X * 0.8, 0.07, foot.Size.Z * 1.1), accent, CFrame.new(0, -foot.Size.Y * 0.42, 0), Enum.Material.Metal)
        end
    end

    if head then
        local headTop = head.Size.Y / 2
        local brimSize = Vector3.new(0.2, head.Size.X * 0.88, head.Size.Z * 0.86)
        local brimOffset = CFrame.new(0, headTop + 0.02, 0) * CFrame.Angles(0, 0, math.rad(90))
        local crownColor = skinKey == "Signalman" and Color3.fromRGB(184, 67, 48) or main
        weldedPart("UniformCapBrim", head, brimSize, darkTrim, brimOffset, Enum.Material.Metal, Enum.PartType.Cylinder)

        if skinKey == "Signalman" then
            weldedPart("SignalHelmetCrown", head, Vector3.new(head.Size.X * 0.9, head.Size.Y * 0.46, head.Size.Z * 0.88), crownColor, CFrame.new(0, headTop + head.Size.Y * 0.12, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
            weldedPart("SignalHelmetRim", head, Vector3.new(0.12, head.Size.X * 1.02, head.Size.Z * 0.92), accent, CFrame.new(0, headTop - 0.03, 0) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Metal, Enum.PartType.Cylinder)
        else
            weldedPart("UniformCapCrown", head, Vector3.new(head.Size.X * 0.78, head.Size.Y * 0.34, head.Size.Z * 0.76), crownColor, CFrame.new(0, headTop + head.Size.Y * 0.13, 0), Enum.Material.Fabric, Enum.PartType.Ball)
            weldedPart("UniformCapVisor", head, Vector3.new(head.Size.X * 0.56, 0.1, head.Size.Z * 0.42), accent, CFrame.new(0, headTop + 0.015, -head.Size.Z * 0.42), Enum.Material.Metal)
        end
        weldedPart("UniformCapBadge", head, Vector3.new(0.17, 0.2, 0.08), accent, CFrame.new(0, headTop + head.Size.Y * 0.13, -head.Size.Z * 0.47), Enum.Material.Metal, Enum.PartType.Ball)
    end

    if skinKey == "NightGuard" and torso then
        local front = -(torso.Size.Z / 2 + 0.11)
        weldedPart("NightGuardScarf", torso, Vector3.new(torso.Size.X * 0.74, torso.Size.Y * 0.22, 0.22), accent, CFrame.new(0, torso.Size.Y * 0.34, front), Enum.Material.Fabric, Enum.PartType.Ball)
        weldedPart("NightGuardScarfTail", torso, Vector3.new(0.22, torso.Size.Y * 0.48, 0.12), accent, CFrame.new(torso.Size.X * 0.2, torso.Size.Y * 0.05, front - 0.02), Enum.Material.Fabric)
    elseif skinKey == "Signalman" and torso then
        weldedPart("SignalmanToolRadio", torso, Vector3.new(0.25, 0.34, 0.14), darkTrim, CFrame.new(torso.Size.X * 0.31, torso.Size.Y * 0.28, -(torso.Size.Z / 2 + 0.1)), Enum.Material.Metal)
        weldedPart("SignalmanRadioLamp", torso, Vector3.new(0.08, 0.08, 0.06), Color3.fromRGB(255, 90, 68), CFrame.new(torso.Size.X * 0.31, torso.Size.Y * 0.34, -(torso.Size.Z / 2 + 0.19)), Enum.Material.Neon, Enum.PartType.Ball)
    elseif skinKey == "PlatformWorker" and torso then
        weldedPart("ReflectiveVestStripe", torso, Vector3.new(torso.Size.X * 0.76, 0.12, 0.08), accent, CFrame.new(0, -torso.Size.Y * 0.08, -(torso.Size.Z / 2 + 0.1)), Enum.Material.Neon)
    end

    if skin.ShirtTemplate and skin.ShirtTemplate > 0 then
        local shirt = character:FindFirstChildOfClass("Shirt") or Instance.new("Shirt")
        shirt.ShirtTemplate = "rbxassetid://" .. tostring(skin.ShirtTemplate)
        shirt.Parent = character
    end
    if skin.PantsTemplate and skin.PantsTemplate > 0 then
        local pants = character:FindFirstChildOfClass("Pants") or Instance.new("Pants")
        pants.PantsTemplate = "rbxassetid://" .. tostring(skin.PantsTemplate)
        pants.Parent = character
    end
end
return Appearance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[-- Shared configuration. Replace every 0 marketplace ID with the ID from Creator Dashboard.
local GameConfig = {}

GameConfig.DataStoreName = "LastTrain_PlayerData_v1"
GameConfig.StationSpacing = 600
GameConfig.ObjectiveRewards = { 100, 150, 180, 180, 220, 250, 500 }
GameConfig.Objectives = {
	"登上列車，檢查沒有目的地的車票",
	"調查乘客紀錄簿，找出空白的離站紀錄",
	"找到真正的錄音，關閉錯誤的廣播",
	"拍下異常倒影，找回實驗報告缺頁",
	"調查乘客留下的物品與監視器影像",
	"搜尋事故紀錄，決定是否相信站務員",
	"進入 HOME TERMINAL，揭開列車循環的真相",
}

GameConfig.Stations = {
	{ Name = "新月站", English = "NEW MOON", Accent = Color3.fromRGB(94, 205, 230), Story = "車票沒有目的地。背面卻多了一行字：你的旅程早已開始。" },
	{ Name = "失語站", English = "SILENT", Accent = Color3.fromRGB(132, 220, 162), Story = "候車乘客全都面向牆壁。小女孩把照片塞進你手裡：「不要讓他知道你認出他了。」" },
	{ Name = "回聲站", English = "ECHO", Accent = Color3.fromRGB(250, 194, 93), Story = "錄音說這是第三次循環。控制室外有人敲玻璃，監視器裡卻空無一人。" },
	{ Name = "鏡湖站", English = "MIRROR LAKE", Accent = Color3.fromRGB(105, 190, 245), Story = "湖面倒影慢了幾秒。另一列相同的列車裡，所有乘客都正看著你。" },
	{ Name = "遺忘站", English = "FORGOTTEN", Accent = Color3.fromRGB(244, 181, 113), Story = "監視器拍到三天前的你。影像中的你轉向鏡頭：「不要讓列車到第七站。」" },
	{ Name = "終寂站", English = "LAST MAINTENANCE", Accent = Color3.fromRGB(244, 126, 82), Story = "維修基地停著數十列 LAST TRAIN。站務員摘下帽子，那張臉和你一模一樣。" },
	{ Name = "不存在的終點", English = "HOME TERMINAL", Accent = Color3.fromRGB(255, 218, 132), Story = "原始紀錄寫著你的名字：第七站事故調查員。站務員一直在阻止循環崩塌。" },
}

GameConfig.Endings = {
	Conductor = "你相信站務員，列車載你穿過明亮隧道。你回到熟悉的城市。身後廣播響起，傳出的卻是你的聲音。",
	Truth = "你關閉核心，七站燈光依序熄滅。站務員恢復原貌：「謝謝你，終於有人讓這趟列車停下來。」",
	Station08 = "你啟動封存系統。七個站名消失，電子看板亮起 STATION 08。廣播說：「歡迎回來，調查員。」",
}

-- Purchasable characters are visual loadouts. The default body colors work without any assets.
-- Optional ShirtTemplate/PantsTemplate values accept clothing template asset IDs (not catalog page IDs).
GameConfig.Skins = {
    PlatformWorker = {
        DisplayName = "月台巡守",
        Ability = "穩定步伐：標準移速，適合初次調查。",
        WalkSpeedMultiplier = 1,
        FlashlightMultiplier = 1,
        MonsterDetectionMultiplier = 1,
        PriceCoins = 0,
        GamePassId = 0,
        Colors = { Main = Color3.fromRGB(80, 104, 112), Accent = Color3.fromRGB(216, 171, 78) },
        ShirtTemplate = 0,
        PantsTemplate = 0,
    },
    Conductor = {
        DisplayName = "夜班列車長",
        Ability = "列車長步法：移動速度提高 15%。",
        WalkSpeedMultiplier = 1.15,
        FlashlightMultiplier = 1,
        MonsterDetectionMultiplier = 1,
        PriceCoins = 350,
        GamePassId = 0,
        Colors = { Main = Color3.fromRGB(38, 53, 72), Accent = Color3.fromRGB(220, 187, 111) },
        ShirtTemplate = 0,
        PantsTemplate = 0,
    },
    Signalman = {
        DisplayName = "號誌技師",
        Ability = "訊號探照燈：手電筒照射距離提高 40%。",
        WalkSpeedMultiplier = 1,
        FlashlightMultiplier = 1.4,
        MonsterDetectionMultiplier = 1,
        PriceCoins = 700,
        GamePassId = 0,
        Colors = { Main = Color3.fromRGB(112, 49, 42), Accent = Color3.fromRGB(225, 207, 166) },
        ShirtTemplate = 0,
        PantsTemplate = 0,
    },
    NightGuard = {
        DisplayName = "深夜站務員",
        Ability = "靜默巡查：站務員感知距離降低 25%。",
        WalkSpeedMultiplier = 1,
        FlashlightMultiplier = 1,
        MonsterDetectionMultiplier = 0.75,
        PriceCoins = 0,
        GamePassId = 0, -- Create a one-time game pass, then paste its ID here.
        RequiresGamePass = true,
        Colors = { Main = Color3.fromRGB(28, 31, 36), Accent = Color3.fromRGB(171, 47, 39) },
        ShirtTemplate = 0,
        PantsTemplate = 0,
    },
}

-- Developer products are repeatable Robux purchases. Receipt handling is server-side.
GameConfig.Products = {
    CoinPouch = { DisplayName = "300 張車票幣", ProductId = 0, Coins = 300 },
    CoinCrate = { DisplayName = "1,000 張車票幣", ProductId = 0, Coins = 1000 },
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">TrainFinish</string>
            <string name="Source"><![CDATA[-- A shared finish keeps lobby and playable stock in the same silver livery.
local Finish = {}
Finish.Silver = Color3.fromRGB(150, 160, 176)
Finish.Roof = Color3.fromRGB(169, 179, 194)
Finish.Orange = Color3.fromRGB(219, 106, 38)
Finish.Graphite = Color3.fromRGB(25, 29, 35)
local bodyNames = {
 CarBodyShell=true, ContinuousCoachRoof=true, RoofShoulder=true,
 CoachLowerSideSkin=true, CoachUpperSideSkin=true, DoorJambLowerSkin=true,
 DoorJambHeaderSkin=true, DoorJambMiddleSkin=true, CoachEndSideSkin=true,
 LowerSidePanel_Front=true, LowerSidePanel_Rear=true, SideHeader=true,
 FlushServicePanel=true, DoorFrame=true, ConnectedCeiling=true,
 DisplayCarBody=true, DisplayShoulderBody=true, DisplaySculptedNose=true, DisplayPassengerDoor=true,
}
local orangeNames = {CyanBeltline=true,BeltlineAccent_Front=true,BeltlineAccent_Rear=true,DisplayCyanStripe=true}
local blackNames = {GoldBeltline=true,ContinuousLowerSkirt=true,DisplayLowerBlueStripe=true,DisplayContinuousSkirt=true}
function Finish.Apply(model)
 for _,p in ipairs(model:GetDescendants()) do
  if p:IsA("BasePart") then
   if bodyNames[p.Name] then
    p.Color = p.Name=="ContinuousCoachRoof" and Finish.Roof or Finish.Silver
    p.Material = Enum.Material.Metal
    p.Reflectance = 0.2
   elseif orangeNames[p.Name] then
    p.Color=Finish.Orange; p.Material=Enum.Material.Metal; p.Reflectance=0.08
   elseif blackNames[p.Name] then
    p.Color=Finish.Graphite; p.Material=Enum.Material.Metal; p.Reflectance=0.1
   elseif p.Name=="PanoramicWindowBand" or p.Name=="DisplayWindowBand" then
    p.Color=Color3.fromRGB(15,21,28); p.Reflectance=0.16; p.Transparency=0.12
   end
  end
 end
end
return Finish
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">TrainGeometry</string>
            <string name="Source"><![CDATA[-- A continuous tapered cab skin made from adjoining native triangles. The
-- windshield and livery follow the same surface, so no flat mask floats ahead
-- of the nose. No external mesh permissions or third-party assets are required.
local Finish = require(script.Parent.TrainFinish)
local Geometry = {}
local function triangle(parent,a,b,c,color,material,endName)
 local ab,ac,bc=b-a,c-a,c-b
 if ab:Dot(ab)>ac:Dot(ac) and ab:Dot(ab)>bc:Dot(bc) then a,c=c,a
 elseif ac:Dot(ac)>bc:Dot(bc) then a,b=b,a end
 ab,ac,bc=b-a,c-a,c-b
 local cross=ac:Cross(ab)
 if cross.Magnitude<0.00001 then return end
 local right=cross.Unit
 local back=bc.Unit
 local up=bc:Cross(right).Unit
 local height=math.abs(ab:Dot(up))
 for i,data in ipairs({{(a+b)/2,right,back,math.abs(ab:Dot(back))},{(a+c)/2,-right,-back,math.abs(ac:Dot(back))}}) do
  if data[4]>0.0001 and height>0.0001 then
   local p=Instance.new("WedgePart")
   p.Name="CabSurface_"..endName
   p.Size=Vector3.new(0.025,height,data[4])
   p.CFrame=CFrame.fromMatrix(data[1],data[2],up,data[3])
   p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CastShadow=false
   p.Color=color; p.Material=material
   p.Reflectance=material==Enum.Material.Glass and 0.14 or 0.2
   p:SetAttribute("CabEnd",endName)
   p.Parent=parent
  end
 end
end
function Geometry.BuildCab(parent,endName,shoulderX,direction)
 local rings,sides,length=16,24,26.7
 local function surface(t,angle)
  local width=5.85*math.cos(t*math.pi/2)^0.72+0.035
  local height=4.15*(1-0.88*t^1.45)
  local y=4.1-1.45*t
  return Vector3.new(shoulderX+direction*length*t,y+height*math.sin(angle),width*math.cos(angle))
 end
 for ring=0,rings-1 do
  local t0,t1=ring/rings,(ring+1)/rings
  for side=0,sides-1 do
   local angle0,angle1=2*math.pi*side/sides,2*math.pi*(side+1)/sides
   local mid=(angle0+angle1)/2
   local windshield=ring>=1 and ring<=5 and math.sin(mid)>0.78
   local orange=math.sin(mid)>-0.62 and math.sin(mid)<-0.38
   local color=windshield and Finish.Graphite or (orange and Finish.Orange or Finish.Silver)
   local material=windshield and Enum.Material.Glass or Enum.Material.Metal
   local a,b,c,d=surface(t0,angle0),surface(t1,angle0),surface(t0,angle1),surface(t1,angle1)
   triangle(parent,a,b,c,color,material,endName)
   triangle(parent,b,d,c,color,material,endName)
  end
 end
 local tip=Instance.new("Part")
 tip.Name="CabTip_"..endName; tip.Shape=Enum.PartType.Ball
 tip.Size=Vector3.new(0.18,1.0,0.18)
 tip.Position=Vector3.new(shoulderX+direction*length,2.65,0)
 tip.Color=Finish.Silver; tip.Material=Enum.Material.Metal; tip.Reflectance=0.2
 tip.Anchored=true; tip.CanCollide=false; tip:SetAttribute("CabEnd",endName); tip.Parent=parent
 for _,side in ipairs({-1,1}) do
  local t=0.66
  local position=surface(t,side==1 and 0.05 or math.pi-0.05)
  local lamp=Instance.new("Part"); lamp.Name="CabHeadlamp_"..endName
  lamp.Shape=Enum.PartType.Ball; lamp.Size=Vector3.new(1.5,0.28,0.18)
  lamp.Position=position+Vector3.new(0,0,side*0.04)
  lamp.Color=Color3.fromRGB(255,234,194); lamp.Material=Enum.Material.Neon
  lamp.Anchored=true; lamp.CanCollide=false; lamp:SetAttribute("CabEnd",endName); lamp.Parent=parent
 end
end
return Geometry
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">LastTrain</string>
      </Properties>
      <Item class="Script" referent="10">
        <Properties>
          <string name="Name">Atmosphere</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")

local Workspace = game:GetService("Workspace")
while Workspace:GetAttribute("LastTrainMode") == nil do
	Workspace:GetAttributeChangedSignal("LastTrainMode"):Wait()
end
local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
atmosphere.Parent = Lighting
local color = Lighting:FindFirstChild("LastTrainColor") or Instance.new("ColorCorrectionEffect")
color.Name = "LastTrainColor"
color.Parent = Lighting
local bloom = Lighting:FindFirstChild("LastTrainBloom") or Instance.new("BloomEffect")
bloom.Name = "LastTrainBloom"
bloom.Parent = Lighting

local function applyLighting(isLobby)
	Lighting.ClockTime = isLobby and 20.4 or 20.15
	Lighting.Brightness = isLobby and 3.1 or 2.05
	Lighting.ExposureCompensation = isLobby and 0.18 or -0.12
	Lighting.GlobalShadows = true
	Lighting.Ambient = isLobby and Color3.fromRGB(158, 171, 180) or Color3.fromRGB(68, 82, 95)
	Lighting.OutdoorAmbient = isLobby and Color3.fromRGB(121, 136, 148) or Color3.fromRGB(47, 62, 78)
	Lighting.EnvironmentDiffuseScale = 0.42
	Lighting.EnvironmentSpecularScale = 0.8
	Lighting.FogColor = Color3.fromRGB(22, 31, 43)
	Lighting.FogStart = isLobby and 1000 or 250
	Lighting.FogEnd = isLobby and 3000 or 620
	atmosphere.Color = Color3.fromRGB(151, 174, 193)
	atmosphere.Decay = Color3.fromRGB(39, 53, 70)
	atmosphere.Density = isLobby and 0 or 0.07
	atmosphere.Glare = isLobby and 0.03 or 0.06
	atmosphere.Haze = isLobby and 0 or 0.36
	atmosphere.Offset = 0.1
	color.Brightness = 0.015
	color.Contrast = isLobby and 0.035 or 0.1
	color.Saturation = isLobby and 0.03 or -0.12
	color.TintColor = isLobby and Color3.fromRGB(222, 236, 232) or Color3.fromRGB(239, 243, 250)
	bloom.Intensity = isLobby and 0.06 or 0.07
	bloom.Size = 14
	bloom.Threshold = 1.45
end

applyLighting(Workspace:GetAttribute("LastTrainMode") == "Lobby")
Workspace:GetAttributeChangedSignal("LastTrainMode"):Connect(function()
	applyLighting(Workspace:GetAttribute("LastTrainMode") == "Lobby")
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local root = ReplicatedStorage:FindFirstChild("LastTrain")
if not root then
    root = Instance.new("Folder")
    root.Name = "LastTrain"
    root.Parent = ReplicatedStorage
end

local remotes = root:FindFirstChild("Remotes")
if not remotes then
    remotes = Instance.new("Folder")
    remotes.Name = "Remotes"
    remotes.Parent = root
end

local function ensure(className, name)
    local object = remotes:FindFirstChild(name)
    if not object then
        object = Instance.new(className)
        object.Name = name
        object.Parent = remotes
    end
    return object
end

ensure("RemoteEvent", "ObjectiveUpdate")
ensure("RemoteFunction", "ShopRequest")
ensure("RemoteFunction", "MatchmakingRequest")
ensure("RemoteEvent", "MatchmakingUpdate")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="12">
        <Properties>
          <string name="Name">CharacterShopServer</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local root = ReplicatedStorage:WaitForChild("LastTrain")
local GameConfig = require(root:WaitForChild("Shared"):WaitForChild("GameConfig"))
local shopRequest = root:WaitForChild("Remotes"):WaitForChild("ShopRequest")
local Profiles = require(script.Parent:WaitForChild("ProfileService"))

local passToSkin = {}
local productById = {}
local lastRequestAt = {}
for skinKey, skin in pairs(GameConfig.Skins) do
    if skin.GamePassId and skin.GamePassId > 0 then
        passToSkin[skin.GamePassId] = skinKey
    end
end
for productKey, product in pairs(GameConfig.Products) do
    if product.ProductId and product.ProductId > 0 then
        productById[product.ProductId] = { Key = productKey, Coins = product.Coins }
    end
end

local function waitForProfile(player)
    local deadline = os.clock() + 20
    while player.Parent and not Profiles.IsLoaded(player) and os.clock() < deadline do
        task.wait(0.1)
    end
    return player.Parent ~= nil and Profiles.IsLoaded(player)
end

local function refreshPassOwnership(player, skinKey)
    local skin = GameConfig.Skins[skinKey]
    if not skin or not skin.GamePassId or skin.GamePassId <= 0 then return end
    for attempt = 1, 3 do
        local success, ownsPass = pcall(function()
            return MarketplaceService:UserOwnsGamePassAsync(player.UserId, skin.GamePassId)
        end)
        if success then
            if ownsPass and player.Parent then
                Profiles.GrantSkin(player, skinKey)
            end
            return
        end
        if attempt < 3 then task.wait(attempt) end
    end
    warn("Could not verify game pass for user " .. tostring(player.UserId))
end

Players.PlayerAdded:Connect(function(player)
    task.spawn(function()
        if not waitForProfile(player) then return end
        for skinKey in pairs(passToSkin) do
            refreshPassOwnership(player, skinKey)
        end
    end)
end)
for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(function()
        if not waitForProfile(player) then return end
        for skinKey in pairs(passToSkin) do
            refreshPassOwnership(player, skinKey)
        end
    end)
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
    local skinKey = passToSkin[gamePassId]
    if not skinKey or not wasPurchased then return end
    task.spawn(function()
        -- Verify ownership against Roblox before the experience grants the permanent character.
        refreshPassOwnership(player, skinKey)
    end)
end)

shopRequest.OnServerInvoke = function(player, action, key)
    if type(action) ~= "string" then
        return { ok = false, message = "無效的商店請求。" }
    end
    local now = os.clock()
    if action ~= "GetState" then
        if now - (lastRequestAt[player.UserId] or 0) < 0.25 then
            return { ok = false, message = "操作太快，請稍候。" }
        end
        lastRequestAt[player.UserId] = now
    end
    if not waitForProfile(player) then
        return { ok = false, message = "資料尚未載入，請稍後再試。" }
    end

    if action == "GetState" then
        return { ok = true, state = Profiles.GetState(player) }
    end
    if type(key) ~= "string" then
        return { ok = false, message = "無效的商店請求。" }
    end

    if action == "BuyCoins" then
        local succeeded, message = Profiles.BuySkin(player, key)
        return { ok = succeeded, message = message, state = Profiles.GetState(player) }
    elseif action == "Equip" then
        local succeeded, message = Profiles.EquipSkin(player, key)
        return { ok = succeeded, message = message, state = Profiles.GetState(player) }
    elseif action == "PromptPass" then
        local skin = GameConfig.Skins[key]
        if not skin or not skin.GamePassId or skin.GamePassId <= 0 then
            return { ok = false, message = "這個角色尚未設定 Robux 商品。" }
        end
        return { ok = true, promptType = "GamePass", id = skin.GamePassId }
    elseif action == "PromptProduct" then
        local product = GameConfig.Products[key]
        if not product or not product.ProductId or product.ProductId <= 0 then
            return { ok = false, message = "這個商品尚未設定 Robux 商品 ID。" }
        end
        return { ok = true, promptType = "Product", id = product.ProductId }
    end

    return { ok = false, message = "不支援的商店操作。" }
end

-- ProcessReceipt is the sole authority for granting repeatable Robux products.
Players.PlayerRemoving:Connect(function(player)
    lastRequestAt[player.UserId] = nil
end)

MarketplaceService.ProcessReceipt = function(receiptInfo)
    local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
    local product = productById[receiptInfo.ProductId]
    if not player or not product then
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end

    local granted = Profiles.GrantCoinsFromReceipt(
        receiptInfo.PlayerId,
        receiptInfo.PurchaseId,
        product.Coins
    )
    if granted then
        return Enum.ProductPurchaseDecision.PurchaseGranted
    end
    return Enum.ProductPurchaseDecision.NotProcessedYet
end
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="13">
        <Properties>
          <string name="Name">ExperienceMode</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- The public place is the lobby. Reserved servers are private round instances.
local Workspace = game:GetService("Workspace")
local mode = game.PrivateServerId ~= "" and "Game" or "Lobby"
Workspace:SetAttribute("LastTrainMode", mode)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">LobbyWorldBuilder</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")
local TrainGeometry = require(game:GetService("ReplicatedStorage").LastTrain.Shared:WaitForChild("TrainGeometry"))
local TrainFinish = require(game:GetService("ReplicatedStorage").LastTrain.Shared:WaitForChild("TrainFinish"))
while Workspace:GetAttribute("LastTrainMode") == nil do
	Workspace:GetAttributeChangedSignal("LastTrainMode"):Wait()
end
if Workspace:GetAttribute("LastTrainMode") ~= "Lobby" then return end

local old = Workspace:FindFirstChild("LastTrainLobby")
if old then old:Destroy() end
local lobby = Instance.new("Folder")
lobby.Name = "LastTrainLobby"
lobby.Parent = Workspace

local function part(name, size, position, color, material, transparency, collide)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Position = position
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.Anchored = true
	p.CanCollide = collide ~= false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = lobby
	return p
end

local midnight = Color3.fromRGB(43, 60, 72)
local steel = Color3.fromRGB(145, 161, 170)
local cyan = Color3.fromRGB(75, 205, 221)
local gold = Color3.fromRGB(226, 181, 91)
part("PolishedStoneFloor", Vector3.new(190, 1, 200), Vector3.new(0, -0.5, 0), Color3.fromRGB(132, 148, 156), Enum.Material.Marble)
-- Inlaid floor lanes and a framed central concourse break up the broad stone
-- surface without adding collision clutter to the player routes.
for _, x in ipairs({-82, -62, 62, 82}) do
	part("FloorInlayLong", Vector3.new(0.22, 0.035, 120), Vector3.new(x, 0.025, 0), Color3.fromRGB(129, 150, 151), Enum.Material.Metal, 0, false)
end
for _, z in ipairs({-90, -70, 70, 90}) do
	part("FloorInlayCross", Vector3.new(170, 0.035, 0.22), Vector3.new(0, 0.025, z), Color3.fromRGB(129, 150, 151), Enum.Material.Metal, 0, false)
end
for _, x in ipairs({-12, 12}) do
	part("ConcourseWayfindingLine", Vector3.new(0.42, 0.045, 118), Vector3.new(x, 0.035, 1), cyan, Enum.Material.Neon, 0.12, false)
end
part("LobbyCeiling", Vector3.new(190, 2, 200), Vector3.new(0, 24, 0), midnight, Enum.Material.Metal)
part("RearWall", Vector3.new(190, 24, 2), Vector3.new(0, 12, -100), steel, Enum.Material.Concrete)
part("FrontGlassWall", Vector3.new(190, 24, 1), Vector3.new(0, 12, 100), Color3.fromRGB(38, 74, 87), Enum.Material.Glass, 0.45, false)
for _, x in ipairs({-96, 96}) do
	part("SideWall", Vector3.new(2, 24, 200), Vector3.new(x, 12, 0), steel, Enum.Material.Concrete)
end

-- Repeated metal ribs and inset wall bays give the terminal a designed, vaulted
-- station profile instead of the original empty rectangular hall.
for _, z in ipairs({-84, -56, -28, 0, 28, 56, 84}) do
	local points = {}
	for segment = 0, 8 do
		local angle = math.pi * segment / 8
		local x = math.cos(angle) * 88
		local y = 4 + math.sin(angle) * 18
		table.insert(points, Vector3.new(x, y, z))
	end
	for segment = 1, #points - 1 do
		local a, b = points[segment], points[segment + 1]
		local length = (b - a).Magnitude
		local rib = part("VaultRib", Vector3.new(length + 0.2, 0.66, 0.66), (a + b) / 2, Color3.fromRGB(142, 159, 166), Enum.Material.Metal, 0, false)
		rib.Shape = Enum.PartType.Cylinder
		rib.CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0)
	end
	local crown = part("VaultCrownLight", Vector3.new(28, 0.18, 1.1), Vector3.new(0, 21.4, z), cyan, Enum.Material.Neon, 0.12, false)
	local glow = Instance.new("SurfaceLight"); glow.Face = Enum.NormalId.Bottom; glow.Range = 22; glow.Brightness = 1.1; glow.Color = cyan; glow.Parent = crown
end
for _, z in ipairs({-92, -76, -60, -44, -28, -12, 4, 20, 36, 52, 68, 84}) do
	for _, side in ipairs({-1, 1}) do
		part("WallCladdingBay", Vector3.new(0.16, 14, 12), Vector3.new(side * 94.85, 10, z), Color3.fromRGB(108, 129, 139), Enum.Material.SmoothPlastic, 0, false)
		part("WallBayReveal", Vector3.new(0.12, 0.14, 10.8), Vector3.new(side * 94.72, 16.8, z), cyan, Enum.Material.Neon, 0.22, false)
	end
end

	for _, z in ipairs({-84, -56, -28, 0, 28, 56, 84}) do
	local strip = part("CeilingLight", Vector3.new(148, 0.2, 1.6), Vector3.new(0, 22.7, z), Color3.fromRGB(227, 242, 236), Enum.Material.Neon, 0, false)
	local light = Instance.new("SurfaceLight")
	light.Face = Enum.NormalId.Bottom
	light.Range = 34
	light.Brightness = 2.7
	light.Color = Color3.fromRGB(197, 233, 231)
	light.Parent = strip
end
for _, x in ipairs({-76, -38, 38, 76}) do
	local pillar = part("OvalLobbyPillar", Vector3.new(22, 3.2, 3.2), Vector3.new(x, 11, 4), Color3.fromRGB(124, 148, 151), Enum.Material.SmoothPlastic)
	pillar.Shape = Enum.PartType.Cylinder
	pillar.CFrame = CFrame.new(pillar.Position) * CFrame.Angles(0, 0, math.rad(90))
	part("PillarFoot", Vector3.new(5, 0.65, 5), Vector3.new(x, 0.3, 4), midnight, Enum.Material.Metal)
	local accent = part("PillarAccent", Vector3.new(0.18, 3.25, 3.25), Vector3.new(x, 18.7, 4), cyan, Enum.Material.Neon, 0, false)
	accent.Shape = Enum.PartType.Cylinder
	accent.CFrame = CFrame.new(accent.Position) * CFrame.Angles(0, 0, math.rad(90))
end

-- Platform-style information furniture gives the lobby a finished terminal
-- identity and makes the story, queue and route legible at a glance.
local infoBoard = part("DepartureBoardHousing", Vector3.new(30, 6.8, 0.8), Vector3.new(0, 14.8, -63.6), midnight, Enum.Material.Metal)
local boardFace = part("DepartureBoardFace", Vector3.new(28.4, 5.2, 0.12), Vector3.new(0, 14.8, -63.12), Color3.fromRGB(8, 20, 27), Enum.Material.Glass, 0.04, false)
local boardGui = Instance.new("SurfaceGui")
boardGui.Face = Enum.NormalId.Back
boardGui.CanvasSize = Vector2.new(1200, 420)
boardGui.LightInfluence = 0
boardGui.Parent = boardFace
local boardText = Instance.new("TextLabel")
boardText.Size = UDim2.fromScale(1, 1)
boardText.BackgroundTransparency = 1
boardText.Text = "末班車  /  LAST TRAIN\n七站旅程    •    夜間列車    •    請留意月台廣播"
boardText.TextColor3 = Color3.fromRGB(195, 239, 232)
boardText.Font = Enum.Font.GothamBold
boardText.TextScaled = true
boardText.Parent = boardGui
for _, x in ipairs({-54, 54}) do
	local kiosk = part("RouteMapKiosk", Vector3.new(4.4, 5.5, 1.2), Vector3.new(x, 2.75, 4), midnight, Enum.Material.Metal)
	local map = part("RouteMapScreen", Vector3.new(3.8, 4.1, 0.1), Vector3.new(x, 3.05, 3.34), Color3.fromRGB(23, 53, 60), Enum.Material.Glass, 0.02, false)
	local mapGui = Instance.new("SurfaceGui")
	mapGui.Face = Enum.NormalId.Front
	mapGui.CanvasSize = Vector2.new(360, 500)
	mapGui.LightInfluence = 0
	mapGui.Parent = map
	local mapText = Instance.new("TextLabel")
	mapText.Size = UDim2.fromScale(1, 1)
	mapText.BackgroundTransparency = 1
	mapText.Text = "路線圖\n新月 ─ 失語 ─ 回聲\n鏡湖 ─ 遺忘 ─ 終寂 ─ 歸途"
	mapText.TextWrapped = true
	mapText.TextColor3 = cyan
	mapText.Font = Enum.Font.GothamBold
	mapText.TextScaled = true
	mapText.Parent = mapGui
	part("KioskFoot", Vector3.new(5, 0.28, 1.6), Vector3.new(x, 0.14, 4), steel, Enum.Material.Metal)
end

-- A sculpted silver train display makes the lobby read as a high speed terminal.
local train = Instance.new("Model")
train.Name = "LobbyTrainDisplay"
train.Parent = lobby
local shell = part("DisplayCarBody", Vector3.new(1, 1, 1), Vector3.new(-5.5, 4.1, -31), Color3.fromRGB(246, 249, 250), Enum.Material.Metal, 0, false)
local mesh = Instance.new("SpecialMesh")
mesh.MeshType = Enum.MeshType.Sphere
mesh.Scale = Vector3.new(93, 8.3, 11.7)
mesh.Parent = shell
shell.Reflectance = 0.16
shell.Parent = train
local shoulder = part("DisplayShoulderBody",Vector3.new(40,7.2,11.2),Vector3.new(21,4.1,-31),TrainFinish.Silver,Enum.Material.Metal,0,false)
shoulder.Parent=train
local roof = part("ContinuousCoachRoof",Vector3.new(40,.6,10),Vector3.new(21,8,-31),TrainFinish.Roof,Enum.Material.Metal,0,false)
roof.Parent=train
for _,side in ipairs({-1,1}) do
 local edge=part("RoofShoulder",Vector3.new(40,1.7,1.7),Vector3.new(21,7.45,-31+side*5),TrainFinish.Silver,Enum.Material.Metal,0,false)
 edge.Shape=Enum.PartType.Cylinder; edge.Parent=train
end
TrainGeometry.BuildCab(train,"Front",41,1)
for _,surface in ipairs(train:GetChildren()) do
 if surface:IsA("BasePart") and surface:GetAttribute("CabEnd") then surface.Position+=Vector3.new(0,0,-31) end
end
local glass = part("DisplayWindowBand", Vector3.new(91, 2.55, 0.18), Vector3.new(-5, 6.0, -25.08), Color3.fromRGB(12, 31, 43), Enum.Material.Glass, 0.025, false)
glass.Parent = train
local stripe = part("DisplayCyanStripe", Vector3.new(93, 0.26, 0.18), Vector3.new(-5, 2.25, -25.08), cyan, Enum.Material.Neon, 0, false)
stripe.Parent = train
local lowerBlueStripe = part("DisplayLowerBlueStripe", Vector3.new(93, 0.11, 0.18), Vector3.new(-5, 2.18, -24.6), Color3.fromRGB(24, 112, 162), Enum.Material.Metal, 0, false)
lowerBlueStripe.Parent = train
-- Car doors, dark window mullions, a separate lower skirt, and an unmistakable
-- blue/cyan HTSR-style nose band make the display read as a train at a glance.
for _, x in ipairs({-39, -25, -11, 3, 17, 31}) do
	local mullion = part("DisplayWindowMullion", Vector3.new(0.16, 2.8, 0.22), Vector3.new(x, 6, -24.65), Color3.fromRGB(51, 76, 86), Enum.Material.Metal, 0, false); mullion.Parent = train
end
for _, x in ipairs({-30, 10}) do
	local door = part("DisplayPassengerDoor", Vector3.new(3.3, 5.9, 0.2), Vector3.new(x, 4.7, -24.65), Color3.fromRGB(111, 145, 153), Enum.Material.Glass, 0.16, false); door.Parent = train
end
local skirt = part("DisplayContinuousSkirt", Vector3.new(90, 1, 0.42), Vector3.new(-5, 1.9, -24.75), Color3.fromRGB(69, 86, 93), Enum.Material.Metal, 0, false); skirt.Parent = train
for _, x in ipairs({-44, -30, -12, 10, 30, 48}) do
	local bogie = part("DisplayBogie", Vector3.new(7.4, 1.15, 9.6), Vector3.new(x, 1.15, -31), Color3.fromRGB(44, 55, 60), Enum.Material.Metal, 0, false)
	bogie.Parent = train
	for _, z in ipairs({-36, -26}) do
	local wheel = part("DisplayWheel", Vector3.new(0.55, 2.7, 2.7), Vector3.new(x, 0.9, z), Color3.fromRGB(27, 35, 39), Enum.Material.Metal, 0, false)
		wheel.Shape = Enum.PartType.Cylinder
		wheel.CFrame = CFrame.new(x, 0.9, z) * CFrame.Angles(0, math.rad(90), 0)
		wheel.Parent = train
	end
end
local displayTrack = part("DisplayTrack", Vector3.new(126, 0.4, 20), Vector3.new(-1, 0.15, -31), midnight, Enum.Material.Metal, 0, false); displayTrack.Parent = train

TrainFinish.Apply(train)

-- Turn the long display toward the entrance and leave a clear walking lane.
local oldPivot = CFrame.new(-1, 4.7, -31)
-- The default spawn looks down the station's +X axis. Align the train nose with
-- that sightline so players can read the cab instead of seeing a broad side wall.
local newPivot = CFrame.new(-58, 4.7, -14)
for _, descendant in ipairs(train:GetDescendants()) do
	if descendant:IsA("BasePart") then descendant.CFrame = newPivot * oldPivot:ToObjectSpace(descendant.CFrame) end
end

-- Four walk-up party gates sit in two calm side bays, leaving the central
-- entrance-to-platform concourse clear as shown in the approved floor plan.
local gateFolder = Instance.new("Folder")
gateFolder.Name = "MatchmakingGates"
gateFolder.Parent = lobby
local gateColors = {
	Color3.fromRGB(90, 207, 218), Color3.fromRGB(105, 205, 172),
	Color3.fromRGB(232, 190, 99), Color3.fromRGB(221, 139, 104),
}
local gatePositions = {
	Vector3.new(-68, 0, -4), Vector3.new(-68, 0, 28),
	Vector3.new(68, 0, -4), Vector3.new(68, 0, 28),
}
for count, center in ipairs(gatePositions) do
	local x, z = center.X, center.Z
	local accent = gateColors[count]
	local side = x < 0 and 1 or -1
