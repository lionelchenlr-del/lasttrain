      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ProfileService</string>
          <string name="Source"><![CDATA[-- All currency, unlock, and receipt mutations use UpdateAsync so the server owns the result.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage:WaitForChild("LastTrain"):WaitForChild("Shared"):WaitForChild("GameConfig"))
local CharacterAppearance = require(ReplicatedStorage.LastTrain.Shared:WaitForChild("CharacterAppearance"))
local isUnpublishedStudioTest = RunService:IsStudio() and game.PlaceId == 0
local Store
local storeOk, storeResult = pcall(function()
    return DataStoreService:GetDataStore(GameConfig.DataStoreName)
end)
if storeOk then
    Store = storeResult
elseif isUnpublishedStudioTest then
    warn("LastTrain: Studio test is using temporary in-memory player data; publish the experience to enable saving.")
else
    warn("LastTrain: DataStore is unavailable: " .. tostring(storeResult))
end
local Profiles = {}
local cache = {}
local locks = {}
local characterHooks = {}
local appearanceHooks = {}

local function normalize(raw)
    raw = type(raw) == "table" and raw or {}
    local result = {
        Coins = math.max(0, math.floor(tonumber(raw.Coins) or 0)),
        OwnedSkins = {},
        EquippedSkin = "PlatformWorker",
        ProcessedReceipts = {},
    }
    if type(raw.OwnedSkins) == "table" then
        for key, owned in pairs(raw.OwnedSkins) do
            if GameConfig.Skins[key] and owned == true then
                result.OwnedSkins[key] = true
            end
        end
    end
    result.OwnedSkins.PlatformWorker = true
    if type(raw.EquippedSkin) == "string" and GameConfig.Skins[raw.EquippedSkin] then
        result.EquippedSkin = raw.EquippedSkin
    end
    if not result.OwnedSkins[result.EquippedSkin] then
        result.EquippedSkin = "PlatformWorker"
    end
    if type(raw.ProcessedReceipts) == "table" then
        for purchaseId, processed in pairs(raw.ProcessedReceipts) do
            if processed == true and type(purchaseId) == "string" then
                result.ProcessedReceipts[purchaseId] = true
            end
        end
    end
    return result
end

local function applySkin(player, skinKey)
    local skin = GameConfig.Skins[skinKey]
    local character = player.Character
    if not skin or not character then return end

    player:SetAttribute("FlashlightMultiplier", skin.FlashlightMultiplier or 1)
    player:SetAttribute("MonsterDetectionMultiplier", skin.MonsterDetectionMultiplier or 1)
    local humanoid = character:FindFirstChildWhichIsA("Humanoid")
    if humanoid then humanoid.WalkSpeed = 16 * (skin.WalkSpeedMultiplier or 1) end

    CharacterAppearance.Apply(character, skinKey)
end

local function syncPlayer(userId, profile)
    local player = Players:GetPlayerByUserId(userId)
    if not player then return end
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then
        leaderstats = Instance.new("Folder")
        leaderstats.Name = "leaderstats"
        leaderstats.Parent = player
    end
    local coins = leaderstats:FindFirstChild("車票幣")
    if not coins then
        coins = Instance.new("IntValue")
        coins.Name = "車票幣"
        coins.Parent = leaderstats
    end
    coins.Value = profile.Coins
    player:SetAttribute("EquippedSkin", profile.EquippedSkin)
    applySkin(player, profile.EquippedSkin)
end

local function update(userId, transform)
    while locks[userId] do task.wait(0.05) end
    locks[userId] = true
    if isUnpublishedStudioTest then
        local profile = normalize(cache[userId])
        local ok, err = pcall(transform, profile)
        locks[userId] = nil
        if not ok then
            warn("LastTrain local profile update failed for user " .. tostring(userId) .. ": " .. tostring(err))
            return false, nil
        end
        cache[userId] = profile
        syncPlayer(userId, profile)
        return true, profile
    end
    if not Store then
        locks[userId] = nil
        warn("LastTrain profile update skipped because DataStore is unavailable.")
        return false, nil
    end
    local ok, stored = pcall(function()
        return Store:UpdateAsync("u_" .. tostring(userId), function(current)
            local profile = normalize(current)
            transform(profile) -- Must remain non-yielding.
            return profile
        end)
    end)
    locks[userId] = nil
    if not ok then
        warn("LastTrain profile update failed for user " .. tostring(userId) .. ": " .. tostring(stored))
        return false, nil
    end
    local profile = normalize(stored)
    cache[userId] = profile
    syncPlayer(userId, profile)
    return true, profile
end

function Profiles.Load(player)
    if cache[player.UserId] then
        syncPlayer(player.UserId, cache[player.UserId])
        return true
    end
    local ok = update(player.UserId, function(_profile) end)
    if ok and player.Parent then
        if not characterHooks[player.UserId] then
            characterHooks[player.UserId] = player.CharacterAdded:Connect(function()
                task.wait(0.15)
                local latest = cache[player.UserId]
                if latest then applySkin(player, latest.EquippedSkin) end
            end)
        end
        if not appearanceHooks[player.UserId] then
            appearanceHooks[player.UserId] = player.CharacterAppearanceLoaded:Connect(function(character)
                local latest = cache[player.UserId]
                if latest and player.Character == character then applySkin(player, latest.EquippedSkin) end
            end)
        end
        if player.Character then applySkin(player, cache[player.UserId].EquippedSkin) end
    end
    return ok
end

function Profiles.IsLoaded(player)
    return cache[player.UserId] ~= nil
end

function Profiles.GetState(player)
    local profile = cache[player.UserId]
    if not profile then return nil end
    local owned = {}
    for key, value in pairs(profile.OwnedSkins) do owned[key] = value end
    return { Coins = profile.Coins, OwnedSkins = owned, EquippedSkin = profile.EquippedSkin }
end

function Profiles.AwardCoins(player, amount)
    amount = math.floor(tonumber(amount) or 0)
    if amount <= 0 then return false end
    local ok = update(player.UserId, function(profile)
        profile.Coins += amount
    end)
    return ok
end

function Profiles.BuySkin(player, skinKey)
    local skin = GameConfig.Skins[skinKey]
    if not skin then return false, "找不到這個角色。" end
    if skin.RequiresGamePass then
        return false, "此角色需要使用 Robux 購買。"
    end
    local succeeded, message = false, "購買失敗，請稍後再試。"
    local ok = update(player.UserId, function(profile)
        if profile.OwnedSkins[skinKey] then
            succeeded, message = false, "你已經擁有這個角色。"
            return
        end
        local price = math.max(0, math.floor(skin.PriceCoins or 0))
        if profile.Coins < price then
            succeeded, message = false, "車票幣不足。"
            return
        end
        profile.Coins -= price
        profile.OwnedSkins[skinKey] = true
        succeeded, message = true, "角色已解鎖。"
    end)
    if not ok then return false, "資料儲存失敗，請稍後再試。" end
    return succeeded, message
end

function Profiles.EquipSkin(player, skinKey)
    if not GameConfig.Skins[skinKey] then return false, "找不到這個角色。" end
    local succeeded, message = false, "角色切換失敗。"
    local ok = update(player.UserId, function(profile)
        if not profile.OwnedSkins[skinKey] then
            succeeded, message = false, "你尚未解鎖這個角色。"
            return
        end
        profile.EquippedSkin = skinKey
        succeeded, message = true, "已切換角色。"
    end)
    if not ok then return false, "資料儲存失敗，請稍後再試。" end
    return succeeded, message
end

function Profiles.GrantSkin(player, skinKey)
    if not GameConfig.Skins[skinKey] then return false end
    local ok = update(player.UserId, function(profile)
        profile.OwnedSkins[skinKey] = true
    end)
    return ok
end

function Profiles.GrantCoinsFromReceipt(userId, purchaseId, amount)
    if type(purchaseId) ~= "string" or purchaseId == "" then return false end
    amount = math.max(0, math.floor(tonumber(amount) or 0))
    local granted = false
    local ok = update(userId, function(profile)
        if profile.ProcessedReceipts[purchaseId] then
            granted = true -- Roblox may retry an already-completed receipt.
            return
        end
        profile.Coins += amount
        profile.ProcessedReceipts[purchaseId] = true
        granted = true
    end)
    return ok and granted
end

Players.PlayerRemoving:Connect(function(player)
    cache[player.UserId] = nil -- Every mutation is already committed through UpdateAsync.
    if appearanceHooks[player.UserId] then
        appearanceHooks[player.UserId]:Disconnect()
        appearanceHooks[player.UserId] = nil
    end
    if characterHooks[player.UserId] then
        characterHooks[player.UserId]:Disconnect()
        characterHooks[player.UserId] = nil
    end
end)

return Profiles
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="19">
        <Properties>
          <string name="Name">RecoveryGuard</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Return players to the platform if they fall out of the station or get stranded.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local GameConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("LastTrain"):WaitForChild("Shared"):WaitForChild("GameConfig"))

while Workspace:GetAttribute("LastTrainMode") == nil do
	Workspace:GetAttributeChangedSignal("LastTrainMode"):Wait()
end
while Workspace:GetAttribute("LastTrainMode") ~= "Game" do
	Workspace:GetAttributeChangedSignal("LastTrainMode"):Wait()
end

local lastRecovery = {}

RunService.Heartbeat:Connect(function()
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
		if root and humanoid and humanoid.Health > 0 then
			local position = root.Position
			local outsideStation = position.Y < -8
				or position.X < -250 or position.X > GameConfig.StationSpacing * (#GameConfig.Stations - 1) + 250
				or math.abs(position.Z) > 45
			if outsideStation and (not lastRecovery[player] or os.clock() - lastRecovery[player] > 2) then
				lastRecovery[player] = os.clock()
				local stop = math.clamp(Workspace:GetAttribute("LastTrainStation") or 1, 1, 7)
				local x = (stop - 1) * GameConfig.StationSpacing - 80
				character:PivotTo(CFrame.new(x, 3, -22) * CFrame.Angles(0, math.rad(-90), 0))
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	lastRecovery[player] = nil
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="20">
        <Properties>
          <string name="Name">RoundController</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server-owned story progression and carriage movement. Prompts are validated
-- here, and only the server awards currency or advances the train.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local TweenService=game:GetService("TweenService")
local RunService=game:GetService("RunService")
local Workspace=game:GetService("Workspace")
local GameConfig=require(ReplicatedStorage:WaitForChild("LastTrain"):WaitForChild("Shared"):WaitForChild("GameConfig"))
local Profiles=require(script.Parent:WaitForChild("ProfileService"))
local objectiveEvent=ReplicatedStorage:WaitForChild("LastTrain"):WaitForChild("Remotes"):WaitForChild("ObjectiveUpdate")
while Workspace:GetAttribute("LastTrainMode") == nil do
 Workspace:GetAttributeChangedSignal("LastTrainMode"):Wait()
end
while Workspace:GetAttribute("LastTrainMode") ~= "Game" do
 Workspace:GetAttributeChangedSignal("LastTrainMode"):Wait()
end
local world=Workspace:WaitForChild("LastTrainWorld")
while not world:GetAttribute("Ready") do world:GetAttributeChangedSignal("Ready"):Wait() end
local objectiveFolder=world:WaitForChild("Objectives")
local train=world:WaitForChild("Props"):WaitForChild("LastTrainCar")
local stage,completed,choice,traveling=0,false,nil,false
local station=1
local spacing=GameConfig.StationSpacing

local function storyFor(index) return GameConfig.Stations[index] and GameConfig.Stations[index].Story or "" end
local function broadcast(endingKey)
 local data=GameConfig.Stations[station]
 objectiveEvent:FireAllClients(stage,GameConfig.Objectives[math.min(stage+1,#GameConfig.Objectives)],completed,data and data.Name or "",storyFor(station),endingKey)
end
local function setDoors(open)
 for _,d in ipairs(train:GetDescendants()) do if d:IsA("BasePart") then
  if d.Name=="SlidingDoor" then
   -- Only the platform-facing doors open; track-side doors stay sealed.
   local shouldOpen=open and d:GetAttribute("Side")==-1
   local x=d:GetAttribute(shouldOpen and "OpenX" or "ClosedX") or d.Position.X
   d.Position=Vector3.new(x,d.Position.Y,d.Position.Z); d.CanCollide=not shouldOpen
  elseif d.Name=="BoardingBridge" then
   local shouldOpen=open and d:GetAttribute("Side")==-1
   d.Transparency=shouldOpen and 0 or 1; d.CanCollide=shouldOpen
  end
 end end
end
local function boardPlayer(player)
 local character=player.Character; local humanoid=character and character:FindFirstChildWhichIsA("Humanoid")
 if not character or not humanoid or humanoid.Health<=0 then return end
 character:PivotTo(train:GetPivot()*CFrame.new(-10,-1,0)); player:SetAttribute("OnLastTrain",true)
end
-- Keep the ride state in sync with where the player is standing. This lets
-- players walk through the open doors and remain at a station when the train leaves.
RunService.Heartbeat:Connect(function()
 local pivot=train:GetPivot()
 for _,p in ipairs(Players:GetPlayers()) do
  local character=p.Character; local root=character and character:FindFirstChild("HumanoidRootPart")
  if root then
   local localPosition=pivot:PointToObjectSpace(root.Position)
   local aboard=math.abs(localPosition.X)<=96 and localPosition.Y>=-5 and localPosition.Y<=9 and math.abs(localPosition.Z)<=5.8
   p:SetAttribute("OnLastTrain",aboard)
  else p:SetAttribute("OnLastTrain",false) end
 end
end)
local function moveToNextStation()
 traveling=true; setDoors(false)
 local start=train:GetPivot(); local target=start+Vector3.new(spacing,0,0)
 local value=Instance.new("CFrameValue"); value.Value=start
 local previous=start
 local connection=value:GetPropertyChangedSignal("Value"):Connect(function()
  local current=value.Value; local delta=current*previous:Inverse(); train:PivotTo(current)
  for _,p in ipairs(Players:GetPlayers()) do
   if p:GetAttribute("OnLastTrain") then local character=p.Character; local root=character and character:FindFirstChild("HumanoidRootPart"); local h=character and character:FindFirstChildWhichIsA("Humanoid")
    if root and h and h.Health>0 then character:PivotTo(delta*character:GetPivot()) end
   end
  end
  previous=current
 end)
 local tween=TweenService:Create(value,TweenInfo.new(14,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Value=target})
 tween:Play(); tween.Completed:Wait(); connection:Disconnect(); value:Destroy()
 station=math.min(station+1,#GameConfig.Stations); world:SetAttribute("Station",station)
 Workspace:SetAttribute("LastTrainStation",station); traveling=false; setDoors(true); broadcast()
end

-- Initial carriage is already docked at NEW MOON with its doors open.
setDoors(true); Workspace:SetAttribute("LastTrainStation",1); broadcast()
 for _,anchor in ipairs(objectiveFolder:GetChildren()) do
 local p=anchor:FindFirstChildOfClass("ProximityPrompt")
 if p then p.Triggered:Connect(function(player)
  if anchor.Name:match("^BoardTrain_") then
   local requiredStation=anchor:GetAttribute("StationIndex")
   local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
   if not traveling and requiredStation==station and root and (root.Position-anchor.Position).Magnitude<=p.MaxActivationDistance+4 then boardPlayer(player) end
   return
  end
  if completed or traveling or anchor:GetAttribute("ObjectiveStage")~=stage then return end
  local character=player.Character; local root=character and character:FindFirstChild("HumanoidRootPart"); local humanoid=character and character:FindFirstChildWhichIsA("Humanoid")
  if not root or not humanoid or humanoid.Health<=0 or (root.Position-anchor.Position).Magnitude>p.MaxActivationDistance+4 then return end
  if stage==5 then choice=anchor:GetAttribute("Choice") end
  if stage==6 then
   local endingKey=anchor:GetAttribute("Ending")
   if endingKey=="Station08" and choice~="Records" then objectiveEvent:FireClient(player,stage,"需要先找到終寂站的事故紀錄，封存系統才會解鎖。",false,GameConfig.Stations[station].Name,storyFor(station)); return end
   completed=true; Workspace:SetAttribute("LastTrainRoundStage",stage); Profiles.AwardCoins(player,GameConfig.ObjectiveRewards[stage+1] or 0)
   objectiveEvent:FireAllClients(stage,GameConfig.Endings[endingKey] or "旅程結束。",true,GameConfig.Stations[station].Name,storyFor(station),endingKey); return
  end
  stage+=1; Workspace:SetAttribute("LastTrainRoundStage",stage); Profiles.AwardCoins(player,GameConfig.ObjectiveRewards[stage] or 0)
  if stage==5 then choice=anchor:GetAttribute("Choice") or choice end
  broadcast()
  task.spawn(moveToNextStation)
 end) end
end
for _,anchor in ipairs(train:GetDescendants()) do
 if anchor:GetAttribute("PromptType")=="Disembark" then
  local p=anchor:FindFirstChildOfClass("ProximityPrompt")
  if p then p.Triggered:Connect(function(player)
   if traveling or not player:GetAttribute("OnLastTrain") then return end
   local character=player.Character; local humanoid=character and character:FindFirstChildWhichIsA("Humanoid")
   if not character or not humanoid or humanoid.Health<=0 then return end
   local platformCFrame=train:GetPivot()*CFrame.new(0,-2,-16)
   character:PivotTo(platformCFrame); player:SetAttribute("OnLastTrain",false)
  end) end
 end
end
-- Carriage memories are optional, one-time story interactions per player.
for _,item in ipairs(train:GetDescendants()) do
 local promptObject=item:FindFirstChildOfClass("ProximityPrompt")
 local key=item:GetAttribute("NarrativeKey")
 if promptObject and key then promptObject.Triggered:Connect(function(player)
  if traveling or not player:GetAttribute("OnLastTrain") then return end
  local character=player.Character; local root=character and character:FindFirstChild("HumanoidRootPart")
  local humanoid=character and character:FindFirstChildWhichIsA("Humanoid")
  if not root or not humanoid or humanoid.Health<=0 or (root.Position-item.Position).Magnitude>promptObject.MaxActivationDistance+4 then return end
  local playerKey="Read_"..key
  if player:GetAttribute(playerKey) then return end
  player:SetAttribute(playerKey,true)
  objectiveEvent:FireClient(player,stage,item:GetAttribute("NarrativeText") or "車廂裡留下了一段記憶。",false,"列車記憶",item:GetAttribute("NarrativeText") or "")
 end) end
end
Players.PlayerAdded:Connect(function(player)
 task.delay(2,function() if player.Parent then local d=GameConfig.Stations[station]; objectiveEvent:FireClient(player,stage,GameConfig.Objectives[math.min(stage+1,#GameConfig.Objectives)],completed,d and d.Name or "",storyFor(station)) end end)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="21">
        <Properties>
          <string name="Name">StationmasterAI</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Pathfinding chase without a downloaded character asset. Replace the blockout model with a custom rig in the art pass.
local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local GameConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("LastTrain"):WaitForChild("Shared"):WaitForChild("GameConfig"))

while Workspace:GetAttribute("LastTrainMode") == nil do
    Workspace:GetAttributeChangedSignal("LastTrainMode"):Wait()
end
while Workspace:GetAttribute("LastTrainMode") ~= "Game" do
    Workspace:GetAttributeChangedSignal("LastTrainMode"):Wait()
end

local world = Workspace:WaitForChild("LastTrainWorld")
local spawnPart = world:WaitForChild("MonsterSpawn")
local spawnPosition = Vector3.new(spawnPart.Position.X, 0, spawnPart.Position.Z)
local monster = Instance.new("Model")
monster.Name = "Stationmaster"
monster.Parent = world

local root = Instance.new("Part")
root.Name = "Root"
root.Size = Vector3.new(1, 1, 1)
root.Transparency = 1
root.Anchored = true
root.CanCollide = false
root.CanTouch = false
root.Position = spawnPosition + Vector3.new(0, 0.5, 0)
root.Parent = monster
monster.PrimaryPart = root

local function piece(name, size, offset, color, material)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Color = color
    part.Material = material or Enum.Material.SmoothPlastic
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CastShadow = true
    part.CFrame = CFrame.new(spawnPosition + offset)
    part.Parent = monster
    return part
end

piece("LongCoat", Vector3.new(2.8, 4.4, 1.45), Vector3.new(0, 3.4, 0), Color3.fromRGB(15, 20, 24), Enum.Material.Fabric)
piece("Collar", Vector3.new(1.8, 0.55, 1.2), Vector3.new(0, 5.6, 0), Color3.fromRGB(95, 35, 33), Enum.Material.Fabric)
piece("BlankFace", Vector3.new(1.65, 1.9, 1.25), Vector3.new(0, 6.85, 0), Color3.fromRGB(172, 177, 167), Enum.Material.SmoothPlastic)
piece("Cap", Vector3.new(2.5, 0.5, 2.2), Vector3.new(0, 7.95, 0), Color3.fromRGB(18, 23, 28), Enum.Material.Fabric)
piece("CapBrim", Vector3.new(2.9, 0.15, 1), Vector3.new(0, 7.7, -0.75), Color3.fromRGB(18, 23, 28), Enum.Material.Fabric)
for _, x in ipairs({-0.42, 0.42}) do
    local eye = piece("RedEye", Vector3.new(0.22, 0.13, 0.08), Vector3.new(x, 6.95, -0.66), Color3.fromRGB(200, 39, 31), Enum.Material.Neon)
    eye.CastShadow = false
end
for _, x in ipairs({-1.85, 1.85}) do
    piece("Sleeve", Vector3.new(0.8, 3.9, 0.9), Vector3.new(x, 3.55, 0), Color3.fromRGB(18, 23, 27), Enum.Material.Fabric)
end
for _, x in ipairs({-0.78, 0.78}) do
    piece("TrouserLeg", Vector3.new(0.9, 2.3, 1), Vector3.new(x, 1.05, 0), Color3.fromRGB(21, 25, 29), Enum.Material.Fabric)
end

local function setModelPosition(position, direction)
    local look = Vector3.new(direction.X, 0, direction.Z)
    if look.Magnitude < 0.01 then look = Vector3.new(0, 0, -1) end
    local target = CFrame.lookAt(Vector3.new(position.X, 0.5, position.Z), Vector3.new(position.X, 0.5, position.Z) + look.Unit)
    monster:PivotTo(target)
end

local active = false
local speed = 10.5
local function nearestPlayer()
    local bestRoot, bestDistance, bestRange, bestScore
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
        local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
        if humanoid and playerRoot and humanoid.Health > 0 then
            local distance = (playerRoot.Position - root.Position).Magnitude
            local range = 190 * (player:GetAttribute("MonsterDetectionMultiplier") or 1)
            local score = distance / math.max(range, 1)
            if distance <= range and (not bestScore or score < bestScore) then
                bestRoot, bestDistance, bestRange, bestScore = playerRoot, distance, range, score
            end
        end
    end
    return bestRoot, bestDistance, bestRange
end

local function catchNearbyPlayer()
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
        local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
        if humanoid and playerRoot and humanoid.Health > 0 and (playerRoot.Position - root.Position).Magnitude < 4.2 then
            humanoid.Health = 0
        end
    end
end

while true do
    local stage = Workspace:GetAttribute("LastTrainRoundStage") or 0
    local station = math.clamp(Workspace:GetAttribute("LastTrainStation") or 1, 1, 7)
    local stationSpawn = Vector3.new((station - 1) * GameConfig.StationSpacing + 118, 0, 0)
    if (stationSpawn - spawnPosition).Magnitude > 1 then
        spawnPosition = stationSpawn
        setModelPosition(spawnPosition, Vector3.new(-1, 0, 0))
    end
    local shouldHunt = stage >= 1 and stage < 3 and station >= 2 and station <= 3
    if shouldHunt and not active then
        active = true
        setModelPosition(spawnPosition, Vector3.new(-1, 0, 0))
    elseif not shouldHunt and active then
        active = false
        setModelPosition(spawnPosition, Vector3.new(-1, 0, 0))
    end

    if active then
        local target, distance, targetRange = nearestPlayer()
        if target and distance and distance < targetRange then
            local path = PathfindingService:CreatePath({
                AgentRadius = 2,
                AgentHeight = 8,
                AgentCanJump = false,
                WaypointSpacing = 5,
            })
            local success = pcall(function()
                path:ComputeAsync(root.Position, target.Position)
            end)
            if success and path.Status == Enum.PathStatus.Success then
                local waypoints = path:GetWaypoints()
                for index = 2, #waypoints do
                    if not active then break end
                    local destination = Vector3.new(waypoints[index].Position.X, 0.5, waypoints[index].Position.Z)
                    local start = root.Position
                    local delta = Vector3.new(destination.X - start.X, 0, destination.Z - start.Z)
                    local length = delta.Magnitude
                    if length > 0.2 then
                        local direction = delta.Unit
                        local travelled = 0
                        while travelled < length and active do
                            local dt = RunService.Heartbeat:Wait()
                            local step = math.min(speed * dt, length - travelled)
                            travelled += step
                            local position = start + direction * travelled
                            setModelPosition(position, direction)
                            catchNearbyPlayer()
                            local currentTarget, currentDistance, currentRange = nearestPlayer()
                            if not currentTarget or not currentDistance or currentDistance > currentRange + 20 then break end
                            if currentDistance < 4.5 then catchNearbyPlayer() end
                        end
                    end
                    local _, currentDistance, currentRange = nearestPlayer()
                    if not currentDistance or currentDistance > currentRange + 20 then break end
                end
            end
        end
    end
    task.wait(0.45)
end
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="22">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Seven-stop, walkable horror route. All geometry is generated from this file so
-- the map remains editable in Studio without external packages or asset IDs.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TrainFinish = require(ReplicatedStorage.LastTrain.Shared:WaitForChild("TrainFinish"))
local TrainGeometry = require(ReplicatedStorage.LastTrain.Shared:WaitForChild("TrainGeometry"))
local GameConfig = require(ReplicatedStorage:WaitForChild("LastTrain"):WaitForChild("Shared"):WaitForChild("GameConfig"))

-- This place also hosts the public lobby. Only reserved round servers build the route.
while Workspace:GetAttribute("LastTrainMode") ~= "Game" do
	Workspace:GetAttributeChangedSignal("LastTrainMode"):Wait()
end

local old = Workspace:FindFirstChild("LastTrainWorld")
if old then old:Destroy() end
local world = Instance.new("Folder"); world.Name = "LastTrainWorld"; world.Parent = Workspace
world:SetAttribute("Ready", false); world:SetAttribute("Station", 1)
Workspace:SetAttribute("LastTrainRoundStage", 0)
local function folder(name) local f=Instance.new("Folder"); f.Name=name; f.Parent=world; return f end
local geometry, props, objectives = folder("Geometry"), folder("Props"), folder("Objectives")
local C={ concrete=Color3.fromRGB(77,88,95), tile=Color3.fromRGB(105,117,122), dark=Color3.fromRGB(28,37,43), metal=Color3.fromRGB(128,141,145), gold=Color3.fromRGB(233,188,99), cyan=Color3.fromRGB(92,212,226), glass=Color3.fromRGB(31,63,76) }
local function part(parent,name,size,pos,color,material,transparency,collide)
 local p=Instance.new("Part"); p.Name=name; p.Size=size; p.Position=pos; p.Color=color; p.Material=material or Enum.Material.SmoothPlastic; p.Transparency=transparency or 0; p.Anchored=true; p.CanCollide=collide~=false; p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth; p.Parent=parent; return p
end
local function routePart(parent,name,size,pos,color,material,transparency,collide)
 local count=math.ceil(size.X/512)
 local length=size.X/count
 for i=1,count do
  part(parent,name,Vector3.new(length,size.Y,size.Z),pos+Vector3.new(-size.X/2+(i-.5)*length,0,0),color,material,transparency,collide)
 end
end
local function ellipsoid(parent,name,pos,scale,color,material,transparency,collide)
 local p=part(parent,name,Vector3.one,pos,color,material,transparency,collide)
 local mesh=Instance.new("SpecialMesh"); mesh.MeshType=Enum.MeshType.Sphere; mesh.Scale=scale; mesh.Parent=p
 return p
end
local function pointLight(host,color,brightness,range)
 local l=Instance.new("PointLight"); l.Color=color; l.Brightness=brightness; l.Range=range; l.Shadows=false; l.Parent=host; return l
end
local function label(host,text,color,width,height,face)
 local gui=Instance.new("SurfaceGui"); gui.Face=face or Enum.NormalId.Front; gui.CanvasSize=Vector2.new(1000,260); gui.LightInfluence=0; gui.Parent=host
 local t=Instance.new("TextLabel"); t.Size=UDim2.fromScale(1,1); t.BackgroundTransparency=1; t.Text=text; t.TextColor3=color; t.TextStrokeTransparency=.72; t.Font=Enum.Font.GothamBlack; t.TextScaled=true; t.Parent=gui; return gui
end
local function prompt(name,stage,pos,action,objectText,extra)
 local a=part(objectives,name,Vector3.new(2,3,2),pos,C.cyan,Enum.Material.Neon,1,false); a:SetAttribute("ObjectiveStage",stage)
 if extra then for k,v in pairs(extra) do a:SetAttribute(k,v) end end
 local pr=Instance.new("ProximityPrompt"); pr.ActionText=action; pr.ObjectText=objectText; pr.HoldDuration=.65; pr.MaxActivationDistance=11; pr.RequiresLineOfSight=false; pr.Parent=a; return a
end
-- Flush window and trim surfaces on the passenger body.
local function shellSurface(x,y,side,offset)
 local pos=Vector3.new(x,y,side*(5.59+(offset or .035)))
 local right=Vector3.new(side,0,0)
 local up=Vector3.new(0,1,0)
 return pos,right,up,right:Cross(up)
end
local function surfacePanel(parent,name,size,x,y,side,color,material,transparency)
 local pos,right,up,normal=shellSurface(x,y,side,.055)
 local p=part(parent,name,size,pos,color,material,transparency or 0,false)
 p.CFrame=CFrame.fromMatrix(pos,right,up,normal); return p
end
local function curvedWindowBand(parent,name,centerX,side)
 local columns,rows=5,2; local span,height=17,2.7
 for column=1,columns do for row=1,rows do
  local x=centerX-span/2+(column-.5)*span/columns
  local y=2.65+(row-.5)*height/rows
  local pane=surfacePanel(parent,name,Vector3.new(span/columns-.055,height/rows-.055,.1),x,y,side,Color3.fromRGB(18,42,52),Enum.Material.Glass,.035)
  pane.CanCollide=true
  pane.Reflectance=.14
 end end
end
local function curvedStripe(parent,name,side,y,color,thickness)
 local segments=18; local xStart,xEnd=8,62
 for i=1,segments do
  local x=xStart+(i-.5)*(xEnd-xStart)/segments
  local onOpenDoor=name~="GoldBeltline" or x<32 or x>38
  if onOpenDoor then
   local pos=Vector3.new(x,y,side*(5.64+.025))
   local right=side>0 and Vector3.new(1,0,0) or Vector3.new(-1,0,0)
   local p=part(parent,name,Vector3.new((xEnd-xStart)/segments+.03,thickness,.12),pos,color,Enum.Material.Neon,0,false)
   p.CFrame=CFrame.fromMatrix(pos,right,Vector3.new(0,1,0),right:Cross(Vector3.new(0,1,0)))
   p:SetAttribute("SurfaceStripe",true)
  end
 end
end
local function beam(parent,name,a,b,width,color,material)
 local delta=b-a
 local p=part(parent,name,Vector3.new(width,width,delta.Magnitude),(a+b)/2,color,material or Enum.Material.Metal,0,false)
 p.CFrame=CFrame.lookAt((a+b)/2,b)
 return p
end

-- A long route with a 600-stud run between each of the seven stations.
local spacing=GameConfig.StationSpacing
local routeLength=spacing*(#GameConfig.Stations-1)+480
local routeCenter=spacing*(#GameConfig.Stations-1)/2
local routeStart=routeCenter-routeLength/2
local routeEnd=routeCenter+routeLength/2
routePart(geometry,"Foundation",Vector3.new(routeLength,2,66),Vector3.new(routeCenter,-2,0),C.concrete,Enum.Material.Concrete)
routePart(geometry,"ContinuousTrackBed",Vector3.new(routeLength-24,1,22),Vector3.new(routeCenter,-1.1,0),C.dark,Enum.Material.Asphalt)
routePart(geometry,"ContinuousCeiling",Vector3.new(routeLength,2,66),Vector3.new(routeCenter,18,0),C.dark,Enum.Material.Metal)
for _,side in ipairs({-1,1}) do
 routePart(geometry,"ContinuousBackWall",Vector3.new(routeLength,18,2),Vector3.new(routeCenter,8,side*33),C.tile,Enum.Material.Concrete)
 routePart(geometry,"WallLowerTrim",Vector3.new(routeLength,1.3,.24),Vector3.new(routeCenter,2.25,side*31.85),C.dark,Enum.Material.Metal)
end
-- Close the route at both ends; the long side walls and ceiling enclose all seven stops.
for _,x in ipairs({routeStart+1,routeEnd-1}) do
 part(geometry,"TunnelEndWall",Vector3.new(2,18,66),Vector3.new(x,8,0),C.tile,Enum.Material.Concrete)
 part(geometry,"EndWallServiceDoor",Vector3.new(.18,8,5),Vector3.new(x-1.08,4,0),C.dark,Enum.Material.Metal)
 part(geometry,"EndWallExitGlow",Vector3.new(.12,.2,3.5),Vector3.new(x-1.2,7.55,0),C.cyan,Enum.Material.Neon,0,false)
end
for _,z in ipairs({-4.6,4.6}) do routePart(geometry,"ContinuousRail",Vector3.new(routeLength-25,.3,.3),Vector3.new(routeCenter,-.35,z),C.metal,Enum.Material.Metal) end
for x=routeStart+10,routeEnd-10,5 do part(geometry,"TrackSleeper",Vector3.new(.8,.25,13),Vector3.new(x,-.55,0),C.dark,Enum.Material.WoodPlanks) end

-- A silver high-speed style carriage with tapered noses, broad dark glazing,
-- a curved roof, and a bright cyan beltline rather than a box shell.
local train=Instance.new("Model"); train.Name="LastTrainCar"; train.Parent=props
part(train,"CarFloor",Vector3.new(60,.6,11.4),Vector3.new(35,-.2,0),Color3.fromRGB(41,52,59),Enum.Material.Metal)
part(train,"CarInteriorCeiling",Vector3.new(60,.16,11),Vector3.new(35,7.45,0),Color3.fromRGB(157,171,171),Enum.Material.Metal)
train.CarInteriorCeiling.Transparency=1; train.CarInteriorCeiling.CastShadow=false; train.CarInteriorCeiling.CanQuery=false
-- Use a roof crown and separate lower/header skins instead of a solid oval
-- shell. This leaves the glazed bands genuinely open so passengers can see out.
local shell=ellipsoid(train,"CarBodyShell",Vector3.new(35,4.25,0),Vector3.new(60,11.8,12),Color3.fromRGB(193,204,205),Enum.Material.Metal,0,false)
shell.Transparency=1
shell.Reflectance=0
local roofShell=part(train,"ContinuousCoachRoof",Vector3.new(60,.6,10),Vector3.new(35,8.0,0),TrainFinish.Roof,Enum.Material.Metal,0,false)
roofShell.Reflectance=.2
for _,side in ipairs({-1,1}) do
 local shoulder=part(train,"RoofShoulder",Vector3.new(60,1.7,1.7),Vector3.new(35,7.45,side*5),TrainFinish.Silver,Enum.Material.Metal,0,false)
 shoulder.Shape=Enum.PartType.Cylinder
end
for _,side in ipairs({-1,1}) do
 for _,x in ipairs({18,52}) do
  part(train,"CoachLowerSideSkin",Vector3.new(21,2.05,.55),Vector3.new(x,1.4,side*5.3),Color3.fromRGB(193,204,205),Enum.Material.Metal,0,true)
  part(train,"CoachUpperSideSkin",Vector3.new(21,2.95,.58),Vector3.new(x,6.75,side*5.25),Color3.fromRGB(193,204,205),Enum.Material.Metal,0,true)
 end
 for _,x in ipairs({8.25,61.75}) do
  part(train,"CoachEndSideSkin",Vector3.new(6.5,7.4,.4),Vector3.new(x,3.8,side*5.4),TrainFinish.Silver,Enum.Material.Metal,0,true)
 end
 -- Narrow filler panels beside the doors close the coach side cleanly while
 -- keeping the open doorway itself clear when the paired sliders retract.
 for _,x in ipairs({30,40}) do
  part(train,"DoorJambMiddleSkin",Vector3.new(4,2.9,.4),Vector3.new(x,3.85,side*5.4),TrainFinish.Silver,Enum.Material.Metal,0,true)
  part(train,"DoorJambLowerSkin",Vector3.new(4,2.0,.48),Vector3.new(x,1.42,side*5.28),Color3.fromRGB(193,204,205),Enum.Material.Metal,0,true)
  part(train,"DoorJambHeaderSkin",Vector3.new(4,2.45,.5),Vector3.new(x,6.62,side*5.25),Color3.fromRGB(193,204,205),Enum.Material.Metal,0,true)
 end
end
-- Keep the coach body full-width up to its articulated ends. Short, tapered
-- cab shells are only retained at the two outside ends of the three-car set.
TrainGeometry.BuildCab(train,"Rear",26,-1)
TrainGeometry.BuildCab(train,"Front",44,1)
for _,side in ipairs({-1,1}) do
 part(train,"ContinuousLowerSkirt",Vector3.new(46,.62,.3),Vector3.new(35,.62,side*5.5),Color3.fromRGB(65,83,92),Enum.Material.Metal,0,false)
 part(train,"BeltlineAccent_Front",Vector3.new(20,.24,.2),Vector3.new(22,2.25,side*5.75),Color3.fromRGB(19,109,145),Enum.Material.Metal,0,false)
 part(train,"BeltlineAccent_Rear",Vector3.new(20,.24,.2),Vector3.new(48,2.25,side*5.75),Color3.fromRGB(19,109,145),Enum.Material.Metal,0,false)
 part(train,"LowerSidePanel_Front",Vector3.new(20,.42,.12),Vector3.new(18,1.45,side*5.62),Color3.fromRGB(220,227,224),Enum.Material.SmoothPlastic,0,false)
 part(train,"LowerSidePanel_Rear",Vector3.new(20,.42,.12),Vector3.new(52,1.45,side*5.62),Color3.fromRGB(220,227,224),Enum.Material.SmoothPlastic,0,false)
 part(train,"SideHeader",Vector3.new(42,.32,.18),Vector3.new(35,7.98,side*5.66),Color3.fromRGB(196,209,208),Enum.Material.SmoothPlastic,0,false)
 for _,x in ipairs({32,38}) do
  part(train,"DoorFrame",Vector3.new(.24,6.35,.26),Vector3.new(x,3.25,side*5.95),C.metal,Enum.Material.SmoothPlastic,0,false)
 end
 for _,x in ipairs({33.55,36.45}) do
  local d=part(train,"SlidingDoor",Vector3.new(2.9,6.1,.32),Vector3.new(x,2.65,side*5.96),Color3.fromRGB(133,171,178),Enum.Material.Glass,.12,false)
  d:SetAttribute("ClosedX",x); d:SetAttribute("OpenX",x+(x<35 and -3.05 or 3.05)); d:SetAttribute("Side",side)
 end
 curvedWindowBand(train,"PanoramicWindowBand",20,side)
 curvedWindowBand(train,"PanoramicWindowBand",50,side)
 -- Slim window posts, door status lamps and flush maintenance seams add a
 -- finer scale to the long body without breaking its clean high-speed profile.
 for _,x in ipairs({12,28.5,41.5,57,63}) do
  local px,right,up,normal=shellSurface(x,3.8,side,.11)
  local post=part(train,"WindowMullion",Vector3.new(.12,2.25,.1),px,Color3.fromRGB(108,127,132),Enum.Material.Metal,0,false)
  post.CFrame=CFrame.fromMatrix(px,right,up,normal)
 end
 for _,x in ipairs({31.5,38.5}) do
  local lamp=part(train,"DoorStatusLamp",Vector3.new(.28,.12,.1),Vector3.new(x,6.68,side*5.86),Color3.fromRGB(116,233,213),Enum.Material.Neon,0,false)
  lamp:SetAttribute("Side",side)
 end
 for _,x in ipairs({18,26,44,52}) do
